# Copie para .env (nunca vai para o git) e preencha na VPS.
POSTGRES_PASSWORD=
# Processos da API (2 vCPUs: 3 é um bom começo).
API_WORKERS=3
# Opcional: chave pública do DataJud (CNJ). Vazia = a ingestão lê a chave da página oficial.
DATAJUD_CHAVE=
# Opcional: 1 ignora o cache das fontes e carrega de qualquer jeito. Deixe vazio no dia a dia.
PANOPTICO_FORCAR=
# Opcional: URL de upload pré-autenticada (PUT) do armazenamento externo dos backups, terminada
# na barra do diretório; o backup.sh acrescenta o nome do arquivo. Vazia = só backup local.
BACKUP_PAR_URL=
