# HTTPS automático (Let's Encrypt). O domínio vem da variável DOMINIO.
{$DOMINIO} {
	encode zstd gzip

	# API em /api (o prefixo é removido antes de chegar ao FastAPI, que usa --root-path /api)
	handle_path /api/* {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy web:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

www.{$DOMINIO} {
	redir https://{$DOMINIO}{uri} permanent
}
