# Copie para deploy/.env e preencha. Este arquivo (o .env) não vai para o git.

# Domínio público (sem https://). Os registros DNS A de @ e www devem apontar para a VPS.
DOMINIO=panoptico.social.br

# Senha do Postgres de produção. Gere uma longa, por exemplo: openssl rand -hex 24
POSTGRES_PASSWORD=

# Opcional: e-mail de contato exibido no rodapé (ex.: contato@panoptico.social.br).
# Mudou? Rode "docker compose up -d --build web", porque o valor entra no build.
CONTATO_EMAIL=
