# Backend (copie para backend/.env)
DATABASE_URL=postgresql+psycopg://panoptico:panoptico@localhost:5432/panoptico
TEST_DATABASE_URL=postgresql+psycopg://panoptico:panoptico@localhost:5432/panoptico_test
CORS_ORIGINS=["http://localhost:3000"]
# Opcional: chave da API do Portal da Transparência (o lote de emendas não precisa)
PORTAL_TRANSPARENCIA_CHAVE=

# Frontend (copie para frontend/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:8000
# Endereço público do site (links de compartilhar e Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Opcional: e-mail de contato exibido no rodapé
NEXT_PUBLIC_CONTATO_EMAIL=
